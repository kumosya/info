BasedOnStyle: Google
IndentWidth: 4
ColumnLimit: 80
AlignConsecutiveAssignments: true
AlignTrailingComments: true
IncludeCategories:
  - Regex: '<[[:alnum:].h]+>'
    Priority: 1
  - Regex: '<[[:alnum:]]+>'
    Priority: 2
  - Regex: '.*'
    Priority: 3
  - Regex: '^"(kernel)/'
    Priority: 4

UseTab: Never
NamespaceIndentation: All
AccessModifierOffset: 0
IndentAccessModifiers: true
