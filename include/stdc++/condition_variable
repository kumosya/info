#pragma once

#include <atomic>
#include <mutex>

#include "os/abi.h"

namespace std {

class condition_variable {
   public:
    void notify_one() noexcept { sequence_.fetch_add(1, memory_order_release); }
    void notify_all() noexcept { sequence_.fetch_add(1, memory_order_release); }

    void wait(unique_lock<mutex>& lock) {
        const uint64_t sequence = sequence_.load(memory_order_acquire);
        lock.unlock();
        while (sequence_.load(memory_order_acquire) == sequence) {
            os::yield();
        }
        lock.lock();
    }

    template <class Predicate>
    void wait(unique_lock<mutex>& lock, Predicate predicate) {
        while (!predicate()) {
            wait(lock);
        }
    }

   private:
    atomic_uint64_t sequence_{0};
};

}  // namespace std
