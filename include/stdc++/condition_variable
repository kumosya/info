/*
 * C++ 条件等待。
 */

#pragma once

#include <atomic>
#include <mutex>

#include <os/device.h>
#include <os/ipc.h>
#include <os/mm.h>
#include <os/service.h>
#include <os/task.h>

namespace std {

    /* 让线程等待条件变化，与互斥锁配合使用。 */
    class condition_variable {
        public:
            void notify_one() noexcept {
                sequence_.fetch_add(1, memory_order_release);
            }
            void notify_all() noexcept {
                sequence_.fetch_add(1, memory_order_release);
            }

            void wait(unique_lock<mutex>& lock) {
                const uint64_t sequence = sequence_.load(memory_order_acquire);
                lock.unlock();
                while (sequence_.load(memory_order_acquire) == sequence) {
                    os::yield();
                }
                lock.lock();
            }

            template <class Predicate>
            void wait(unique_lock<mutex>& lock, Predicate predicate) {
                while (!predicate()) {
                    wait(lock);
                }
            }

        private:
            atomic_uint64_t sequence_{0};
    };

}  // namespace std
