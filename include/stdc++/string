#pragma once

#include <stddef.h>
#include <string.h>
#include <utility>
#include <vector>

namespace std {

class string {
   public:
    using size_type = size_t;

    string() { data_.push_back('\0'); }

    string(const char* value) : string() { append(value); }

    string(const string&) = default;
    string(string&&) noexcept = default;
    string& operator=(const string&) = default;
    string& operator=(string&&) noexcept = default;

    string& operator=(const char* value) {
        clear();
        return append(value);
    }

    string& append(const char* value) {
        if (value == nullptr) {
            return *this;
        }
        if (!data_.empty()) {
            data_.pop_back();
        }
        while (*value != '\0') {
            data_.push_back(*value++);
        }
        data_.push_back('\0');
        return *this;
    }

    string& append(const string& value) { return append(value.c_str()); }

    string& operator+=(const char* value) { return append(value); }
    string& operator+=(const string& value) { return append(value); }

    void clear() {
        data_.clear();
        data_.push_back('\0');
    }

    const char* c_str() const noexcept {
        return data_.empty() ? "" : data_.data();
    }
    char* data() noexcept { return data_.data(); }
    const char* data() const noexcept { return c_str(); }
    size_t size() const noexcept { return data_.empty() ? 0 : data_.size() - 1; }
    bool empty() const noexcept { return size() == 0; }
    char& operator[](size_t index) { return data_[index]; }
    const char& operator[](size_t index) const { return data_[index]; }

   private:
    vector<char> data_;
};

inline bool operator==(const string& left, const string& right) {
    return strcmp(left.c_str(), right.c_str()) == 0;
}

inline bool operator!=(const string& left, const string& right) {
    return !(left == right);
}

}  // namespace std
